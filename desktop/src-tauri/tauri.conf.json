{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dubbing Studio",
  "version": "0.1.0",
  "identifier": "com.dubbingstudio.app",
  "build": {
    "frontendDist": "../setup",
    "beforeBuildCommand": "uv run --no-project python prepare.py",
    "beforeDevCommand": "uv run --no-project python prepare.py"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dubbing Studio",
        "width": 1360,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Dubbing Studio",
    "category": "Video",
    "shortDescription": "Local video dubbing: Whisper, any LLM, any TTS engine",
    "longDescription": "Dubbing Studio dubs videos on your own computer: speech recognition, translation with any model and voiceover with pluggable TTS engines.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "app/": "app/",
      "python/": "python/"
    },
    "externalBin": ["binaries/uv"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
